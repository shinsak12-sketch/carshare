generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  EMPLOYEE
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  DISABLED
}

model User {
  id           String        @id @default(cuid())
  employeeId   String        @unique
  name         String
  passwordHash String
  role         Role          @default(EMPLOYEE)
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  sessions  Session[]
  auditLogs AuditLog[]
  aiRuns    AiRun[]

  @@index([status])
}

model Session {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
  ip        String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  action    String

  actorUserId     String?
  actor           User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmployeeId String?

  targetType String?
  targetId   String?
  detail     String?

  ip        String?
  userAgent String?

  @@index([createdAt])
  @@index([action])
  @@index([actorEmployeeId])
}

// AI 실행 1건 = 1행. 사용량 통계·실행 이력·사용 제한의 기준.
// 결과 본문·사진·견적서는 저장하지 않음(정책). 판정 집계 숫자만 남김.
model AiRun {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeId String

  tool          String // assess | adjustment | procedure
  promptVersion String
  model         String
  jobId         String? @unique

  status        String // queued | succeeded | failed | blocked
  errorMessage  String?
  blockedReason String?

  photoCount     Int     @default(0)
  estimateAmount Int?
  plateNo        String?
  claimNo        String?

  inputTokens       Int @default(0)
  cachedInputTokens Int @default(0)
  outputTokens      Int @default(0)
  reasoningTokens   Int @default(0)

  costUsd      Float?
  costKrw      Int?
  rateSnapshot Json?
  durationMs   Int?

  verdictCounts Json?

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([tool, createdAt])
  @@index([plateNo])
  @@index([status])
}

// 모델별 단가(100만 토큰당 USD)와 환율. 실행 시점 값이 AiRun.rateSnapshot에 복사됨.
model PricingRate {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  effectiveFrom      DateTime @default(now())
  updatedBy          String?
  model              String
  inputUsdPerM       Float
  cachedInputUsdPerM Float
  outputUsdPerM      Float
  usdToKrw           Float
  note               String?

  @@index([model, effectiveFrom])
}
