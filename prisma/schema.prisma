generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PromptVersion {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  createdBy     String
  promptText    String
  changeSummary String
  isActive      Boolean  @default(false)

  cases AssessmentCase[]
}

model AssessmentCase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  createdBy String

  manufacturer String
  model        String
  year         Int?
  damagedPart  String?
  memo         String?

  estimateText String?

  aiResult Json

  groundTruthVerdict String?
  groundTruthMemo    String?
  confirmedBy        String?
  confirmedAt        DateTime?

  promptVersionId String?
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id])

  images AssessmentImage[]

  @@index([createdAt])
}

model AssessmentImage {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  mimeType  String
  data      Bytes

  caseId String
  case   AssessmentCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}
