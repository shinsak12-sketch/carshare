# 개발 중 무료로 테스트하려면 GROQ_API_KEY만 채우면 됨 (Groq, OpenAI 호환 API).
# GROQ_API_KEY가 있으면 OPENAI_API_KEY보다 우선 사용됨. 나중에 실제 운영으로
# 넘어갈 땐 GROQ_API_KEY를 지우고 OPENAI_API_KEY만 남기면 자동으로 GPT-4o로 전환.
GROQ_API_KEY=
OPENAI_API_KEY=
# 특정 모델을 강제로 쓰고 싶을 때만 지정 (기본값: Groq는 qwen3-vl, OpenAI는 gpt-4o)
AI_MODEL=

# Neon Postgres — Vercel의 Neon 통합(Integration)을 연결하면 자동으로 채워짐
# 구조화 데이터(계정, 진단 이력, 프롬프트 버전, 로그)를 저장함. 파손 사진은
# 저장소 절약을 위해 DB에 저장하지 않고 GPT 호출에만 메모리에서 사용함.
DATABASE_URL=
DIRECT_URL=

# 최초 배포 시 seed가 관리자 계정 1개를 자동 생성함. 반드시 강한 비밀번호로
# 지정할 것 — 지정 안 하면 기본값(changeme123!)으로 생성되어 위험함.
# 로그인 후 관리자 페이지에서 비밀번호를 바로 초기화하는 것을 권장.
ADMIN_EMPLOYEE_ID=admin
ADMIN_NAME=시스템 관리자
ADMIN_INITIAL_PASSWORD=
