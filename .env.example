# 개발 중 무료로 테스트하려면 GROQ_API_KEY만 채우면 됨 (Groq, OpenAI 호환 API).
# GROQ_API_KEY가 있으면 OPENAI_API_KEY보다 우선 사용됨. 나중에 실제 운영으로
# 넘어갈 땐 GROQ_API_KEY를 지우고 OPENAI_API_KEY만 남기면 자동으로 GPT-4o로 전환.
GROQ_API_KEY=
OPENAI_API_KEY=
# 특정 모델을 강제로 쓰고 싶을 때만 지정 (기본값: Groq는 qwen3-vl, OpenAI는 gpt-4o)
AI_MODEL=

# Neon Postgres — Vercel의 Neon 통합(Integration)을 연결하면 자동으로 채워짐
# 구조화 데이터(진단 이력, 프롬프트 버전)와 사진(바이너리)까지 여기 한 곳에 저장함
DATABASE_URL=
DIRECT_URL=
